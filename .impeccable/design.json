      "css": ".ds-field{font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"PingFang SC\",sans-serif;display:grid;gap:5px;font-size:13px;line-height:1.6;color:var(--ink,#10213c);font-weight:600;}.ds-input{font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"PingFang SC\",sans-serif;font-size:14px;line-height:1.6;min-width:0;color:var(--ink,#10213c);border:1px solid #b7c3d4;border-radius:8px;background:var(--surface,#fff);padding:9px 11px;caret-color:var(--accent,#2860ff);}.ds-input::placeholder{color:#657487;opacity:1;}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-input:focus-visible,.ds-nav:focus-visible,.ds-filter:focus-visible{outline:3px solid var(--accent,#2860ff);outline-offset:3px;}"
    },
    {
      "name": "主要导航",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "页头当前页面使用蓝字和下划线；客服侧另用深色栏。",
      "html": "<nav class=\"ds-nav-group\" aria-label=\"主要导航\"><a class=\"ds-nav\" href=\"#home\">首页</a><a class=\"ds-nav ds-nav-active\" href=\"#support\" aria-current=\"page\">服务中心</a><a class=\"ds-nav\" href=\"#cases\">我的服务</a></nav>",
      "css": ".ds-nav-group{font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"PingFang SC\",sans-serif;display:flex;gap:8px;font-size:14px;line-height:1.6;background:var(--surface,#fff);}.ds-nav{display:flex;align-items:center;position:relative;text-decoration:none;padding:8px 14px;min-height:42px;color:var(--ink,#10213c);}.ds-nav:hover,.ds-nav-active{color:var(--accent-hover,#214ed0);}.ds-nav-active{font-weight:700;}.ds-nav-active::after{content:\"\";height:3px;background:var(--accent,#2860ff);position:absolute;left:14px;right:14px;bottom:-7px;border-radius:2px;}.ds-nav:focus-visible{outline:3px solid var(--accent,#2860ff);outline-offset:3px;}@media(max-width:760px){.ds-nav-group{gap:4px;flex-wrap:wrap;}.ds-nav{padding:8px 10px;font-size:12px;flex:1;justify-content:center;white-space:nowrap;}.ds-nav-active::after{bottom:0;}}"
