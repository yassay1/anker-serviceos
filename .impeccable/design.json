      "kind": "button",
      "refersTo": "button-primary",
      "description": "真实提交操作的主要入口；预览仅展示样式。",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"/><path d=\"m21.854 2.147-10.94 10.939\"/></svg>发送消息</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",\"Microsoft YaHei UI\",\"PingFang SC\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;border-radius:8px;padding:8px 12px;font-size:14px;line-height:1.6;font-weight:600;cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;border:1px solid var(--accent,#2860ff);background:linear-gradient(115deg,#3d74ff,#2455f4);box-shadow:0 4px 10px rgb(40 96 255 / 10%);color:var(--surface,#fff);}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#214ed0);border-color:var(--accent-hover,#214ed0);}.ds-primary:disabled{cursor:not-allowed;color:#61727c;border-color:var(--border,#e9ecf2);background:#edf0f4;}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-input:focus-visible,.ds-nav:focus-visible,.ds-filter:focus-visible{outline:3px solid var(--accent,#2860ff);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-filter{transition:none;}}@media(max-width:760px){.ds-primary{min-height:44px;}}"
