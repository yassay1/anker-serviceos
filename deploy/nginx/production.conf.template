# Only SERVICEOS_PUBLIC_HOSTNAME is substituted by the official entrypoint.
server {
    listen 8080 default_server;
    server_name _;
    location = /nginx-health {
        access_log off;
        return 200 "nginx alive; production identity remains gated\n";
    }
    location / { return 444; }
}

server {
    listen 8080;
    server_name ${SERVICEOS_PUBLIC_HOSTNAME};
    return 308 https://${SERVICEOS_PUBLIC_HOSTNAME}$request_uri;
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name ${SERVICEOS_PUBLIC_HOSTNAME};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    root /usr/share/nginx/html;
    include /etc/nginx/serviceos-security.conf;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/ {
        include /etc/nginx/serviceos-proxy.conf;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
