# SAFE LOCAL EXAMPLES ONLY. Copy to deploy/local/.env without overwriting it.
# POSTGRES_PASSWORD must be URL-safe (letters/digits/-/_); it is embedded in a URL.
POSTGRES_DB=serviceos_dev
POSTGRES_USER=serviceos_local
POSTGRES_PASSWORD=local_database_example_only
SERVICEOS_LOCAL_AUTH_PASSWORD=local_login_example_only
SERVICEOS_MOCK_ACTION_RESULT=SUCCEEDED
# Official defaults. Override only with a verified mirror/image digest.
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:1.28-alpine
POSTGRES_IMAGE=pgvector/pgvector:pg17
SERVICEOS_BACKEND_IMAGE=serviceos-backend:local
SERVICEOS_WEB_IMAGE=serviceos-web:local
# The agent profile alone does not supply credentials or authorize model egress.
SERVICEOS_LLM_MODEL=
SERVICEOS_LLM_BASE_URL=
SERVICEOS_LLM_API_KEY=
# Knowledge embeddings are opt-in; without them retrieval stays keyword-only.
SERVICEOS_EMBEDDING_MODEL=
SERVICEOS_EMBEDDING_BASE_URL=
SERVICEOS_EMBEDDING_API_KEY=
