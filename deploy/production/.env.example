# PLACEHOLDERS ONLY; this file passes syntax validation, not deployment approval.
# Replace release tags with verified registry image digests before any deployment.
SERVICEOS_BACKEND_IMAGE=serviceos-backend:release-placeholder
SERVICEOS_WEB_IMAGE=serviceos-web:release-placeholder
SERVICEOS_PUBLIC_HOSTNAME=service.example.invalid
SERVICEOS_DATABASE_URL='postgresql+psycopg://serviceos_app:REPLACE_URL_ENCODED_PASSWORD@database.example.invalid:5432/serviceos?sslmode=verify-full&sslrootcert=/etc/serviceos/rds/global-bundle.pem'
SERVICEOS_RDS_CA_FILE=/opt/serviceos/certs/rds/global-bundle.pem
# Contains fullchain.pem + privkey.pem; readable by nginx UID/GID, not world-readable.
SERVICEOS_TLS_DIR=/opt/serviceos/certs/web
SERVICEOS_S3_BUCKET=replace-private-evidence-bucket
SERVICEOS_S3_REGION=us-east-1
SERVICEOS_S3_PREFIX=production/evidence
# No static AWS keys: use the SDK default chain / EC2 instance IAM role.
# Auth is fixed to disabled in production Compose: business traffic stays blocked.
SERVICEOS_LLM_MODEL=
SERVICEOS_LLM_BASE_URL=
SERVICEOS_LLM_API_KEY=
SERVICEOS_EMBEDDING_MODEL=
SERVICEOS_EMBEDDING_BASE_URL=
SERVICEOS_EMBEDDING_API_KEY=
