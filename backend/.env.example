# Local-only example credentials; never use these for production.
SERVICEOS_DATABASE_URL=postgresql+psycopg://serviceos_local:serviceos_local_only@127.0.0.1:55432/serviceos_dev
SERVICEOS_ENV=development
SERVICEOS_AUTH_MODE=local
SERVICEOS_LOCAL_AUTH_PASSWORD=serviceos_local_only
SERVICEOS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8000
SERVICEOS_LOCAL_AUTH_NETWORKS=127.0.0.0/8,::1/128
SERVICEOS_ALLOW_CONTAINER_BOOTSTRAP=0
# Real model access is opt-in. Set all three only after choosing an approved provider.
# The Worker refuses to claim jobs unless these are present; base URL is explicit to prevent implicit egress.
SERVICEOS_LLM_MODEL=
SERVICEOS_LLM_BASE_URL=
SERVICEOS_LLM_API_KEY=
SERVICEOS_LLM_TIMEOUT_SECONDS=60
SERVICEOS_WORKER_LEASE_SECONDS=90
SERVICEOS_WORKER_HEARTBEAT_SECONDS=20
SERVICEOS_WORKER_MAX_ATTEMPTS=5
# Development image bytes stay in a private local directory outside the database.
# Empty uses backend/.data/evidence. Use an absolute path when overriding it.
SERVICEOS_EVIDENCE_STORAGE_DIR=
SERVICEOS_EVIDENCE_STORAGE_BACKEND=local
SERVICEOS_S3_BUCKET=
SERVICEOS_S3_REGION=
SERVICEOS_S3_PREFIX=evidence
SERVICEOS_MOCK_ACTION_RESULT=SUCCEEDED
# DATABASE_URL, LOCAL_AUTH_PASSWORD and LLM_API_KEY also accept a _FILE secret path instead of a value.
# Integration tests create and drop their own uniquely named database.
# SERVICEOS_TEST_DATABASE_URL=postgresql+psycopg://serviceos_local:serviceos_local_only@127.0.0.1:55432/serviceos_dev
